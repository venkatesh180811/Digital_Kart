# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Kolkata

# MySQL Database
DB_NAME=digitalkart_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email (SMTP for real email delivery)
# For Gmail: use an App Password, not your regular password
# Generate one at: https://support.google.com/accounts/answer/185833
# For other providers: adjust EMAIL_HOST, EMAIL_PORT, EMAIL_USE_TLS accordingly
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=DigitalKart <no-reply@digitalkart.in>

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# AI
OPENAI_API_KEY=

# Business rules
GST_PERCENT=18
FREE_SHIPPING_THRESHOLD=499
STANDARD_SHIPPING_CHARGE=49
